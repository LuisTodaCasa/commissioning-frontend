# =============================================================
# .env.production — Frontend do Sistema de Comissionamento
# =============================================================
# INSTRUÇÕES:
#   1. Crie o app do BACKEND no Abacus primeiro e copie a URL gerada.
#   2. Substitua os valores XXXX abaixo pelas URLs reais.
#   3. Nunca comite este arquivo com valores reais (ele está no .gitignore).
# =============================================================

# URL pública do backend (ex: https://commissioning-backend-abc123.abacus.ai)
NEXT_PUBLIC_BACKEND_URL=https://commissioning-backend-XXXX.abacus.ai

# URL pública do próprio frontend (ex: https://commissioning-frontend-abc123.abacus.ai)
NEXTAUTH_URL=https://commissioning-frontend-XXXX.abacus.ai

# Ambiente
NODE_ENV=production
